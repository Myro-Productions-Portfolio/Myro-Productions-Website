# ============================================================================
# Myro Productions Website — Environment Variables
# Copy this file to .env.local for local dev. Do NOT commit .env.local.
# ============================================================================

# ---- Database (required) ---------------------------------------------------
# For docker-compose local dev, this points at the postgres sidecar.
# For production, set to your real Postgres connection string.
DATABASE_URL="postgresql://myro:myro_dev@localhost:5433/myro_dev?schema=public"

# ---- Authentication (required) ---------------------------------------------
# Must be at least 32 bytes of entropy. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_use_at_least_32_random_bytes"

# Admin seed user — used by `npm run db:seed` only.
# The seed script will refuse to run if ADMIN_SEED_PASSWORD is unset.
ADMIN_SEED_EMAIL="admin@myroproductions.local"
ADMIN_SEED_PASSWORD="CHANGE_ME_seed_password"
ADMIN_SEED_NAME="Admin"

# ---- Stripe (optional for local dev) ---------------------------------------
# Use test-mode keys (sk_test_..., pk_test_...) for development.
# For local webhook testing, run:
#   stripe listen --forward-to localhost:3002/api/stripe/webhooks
# and copy the resulting whsec_ value here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ---- Application URLs ------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3002"
NODE_ENV="development"

# ---- Contact form (optional) -----------------------------------------------
# Used by app/api/contact/route.ts. Optional during local dev.
WEB3FORMS_ACCESS_KEY=""

# ---- Calendly webhook (optional) -------------------------------------------
# Used by app/api/webhooks/calendly/route.ts.
CALENDLY_WEBHOOK_SIGNING_KEY=""

# ---- AWS Bedrock (future — AI chatbot feature) -----------------------------
# Leave unset until the AI chatbot feature is built.
# AWS_REGION="us-east-1"
# BEDROCK_MODEL_ID=""
